# Enable the opt-in, read-only first orchestration slice.
SUBAGENTS_ENABLED=true
SUBAGENT_MAX_CALLS=2
SUBAGENT_MAX_ITERATIONS=1
SUBAGENT_CONCURRENCY=1
SUBAGENT_MUTATION_POLICY=director-approved
SUBAGENT_DEBUG_LOGGING=false
SUBAGENT_USAGE_LOGGING=false

# `host` (default) uses the signed-in Codex/Claude host as the director and
# makes no API request from this server. Set `api` only for unattended,
# server-side OpenAI inspection.
SUBAGENT_EXECUTION_MODE=host

# Model classes are provider-neutral. They are used only in `api` mode by the
# initial OpenAI adapter, when OPENAI_API_KEY is also set.
AGENT_MODEL_CHEAP=
AGENT_MODEL_STANDARD=
AGENT_MODEL_STRONG=
AGENT_MODEL_VISION=

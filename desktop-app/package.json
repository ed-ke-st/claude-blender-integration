{
  "name": "blender-desktop-launcher",
  "version": "0.2.1",
  "description": "Mac desktop launcher for the Claude/Codex/ChatGPT Blender MCP integration",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build:renderer": "vite build",
    "pack:mac": "npm run build:renderer && electron-builder --mac",
    "pack:mac:unsigned": "npm run build:renderer && electron-builder --mac --config.mac.identity=null --config.mac.hardenedRuntime=false --config.mac.entitlements=null --config.mac.entitlementsInherit=null"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "@electron/notarize": "^2.5.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^31.0.2",
    "electron-builder": "^24.13.3",
    "vite": "^6.2.1",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.edward.blenderlauncher",
    "productName": "Blender MCP Launcher",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "afterSign": "build/notarize.js",
    "files": [
      "src/**/*",
      "dist/renderer/**/*",
      "build/icons/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../mcp-server",
        "to": "mcp-server",
        "filter": [
          "**/*",
          "!node_modules/**",
          "!.git/**"
        ]
      },
      {
        "from": "../blender-addon",
        "to": "blender-addon"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icons/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "icon": "build/icons/icon.ico"
    },
    "linux": {
      "icon": "build/icons"
    }
  }
}
